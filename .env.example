# ==============================================================================
# Atmos Environment Configuration Template
# Copy this file to .env and fill in your real credentials:
#   cp .env.example .env
# ==============================================================================

# InfluxDB 2.x Connection Details
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_operator_or_all_access_token_here
INFLUXDB_ORG=Atmos
INFLUXDB_BUCKET=sensor_data

# Optional: Separate bucket for volleyball match records (defaults to INFLUXDB_BUCKET if omitted)
INFLUXDB_VOLLEYBALL_BUCKET=sensor_data

# Optional: Team-PIN / API-Key protection for Volleyball match uploads
# If set, clients must supply this via the 'X-API-Key' header
VOLLEYBALL_API_KEY=

# Server Network Configuration
PORT=8080

# Optional: Path to a built frontend (e.g. SetPoint volleyball/dist), served under /volleyball/
# The Vite build must use `base: '/volleyball/'` for this to work.
STATIC_DIR=

# Landing page links (cards with an empty URL are hidden)
APP_NAME=Atmos
# Defaults to http://localhost:5173, or /volleyball/ if STATIC_DIR is set
VOLLEYBALL_URL=
GRAFANA_URL=http://localhost:3000
INFLUXDB_UI_URL=http://localhost:8086

# Optional: Embed a Grafana dashboard as a second tab on /dashboard.
# Requires `allow_embedding = true` (and anonymous access or a public dashboard) in grafana.ini.
# Example: http://localhost:3000/d/<dashboard-uid>/atmos?orgId=1&kiosk&theme=dark
GRAFANA_EMBED_URL=
